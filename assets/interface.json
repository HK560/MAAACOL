{
    // 本文件主要定义了通用 UI 的行为和显示内容
    // 可参考文档和示例添加更多您需要的功能
    // 文档：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 示例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MAAACOL",
    "description": "皇牌空战OL 自动化辅助工具",
    "contact": "",
    "license": "MIT",
    "welcome": "欢迎使用 MAAACOL！",
    "github": "",
    "version": "0.1.0",
    "controller": [
        {
            "name": "PC 桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "ACE COMBAT 8 : WINGS OF THEVE",
                "screencap": "PrintWindow",
                "mouse": "PostMessageWithCursorPos",
                "keyboard": "PostMessageWithCursorPos"
            }
        }
    ],
    "resource": [
        {
            "name": "默认资源",
            "path": [
                "./resource"
            ]
        }
    ],
    "agent": {
        "child_exec": "python",
        "child_args": [
            "./agent/main.py"
        ]
    },
    "task": [
        {
            "name": "自动化游玩 TDM 模式",
            "entry": "StartTDM"
        }
    ]
}
